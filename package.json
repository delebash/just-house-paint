{
  "name": "just-house-paint",
  "version": "0.1.3",
  "description": "Just House Paint — see your house in real brand paint colors: it finds the house's parts in your photo, paints them with real paints, suggests color schemes and can make an AI photo.",
  "productName": "Just House Paint",
  "author": "delebash",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "quasar dev -m electron",
    "dev:spa": "quasar dev",
    "build": "quasar build -m electron",
    "build:spa": "quasar build",
    "build:unpacked": "quasar build -m electron --skip-pkg",
    "build:android": "quasar build -m capacitor -T android",
    "postinstall": "quasar prepare --silent",
    "prepare": "husky",
    "server": "node scripts/node24.js server/src/serve.js serve",
    "lint": "biome check .",
    "test:server": "node scripts/node24.js node_modules/vitest/vitest.mjs run --config server/vitest.config.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/node24.js node_modules/vitest/vitest.mjs run --config server/vitest.config.js --coverage.enabled --coverage.provider=v8 --coverage.include=src/**/*.js --coverage.reportsDirectory=../coverage/server",
    "bump": "node scripts/bump.js",
    "release": "node scripts/release.js",
    "test": "npm test --prefix e2e",
    "screenshots": "node e2e/capture-direct.js",
    "i18n:lint": "eslint -c eslint.i18n.config.js \"src/**/*.{js,vue}\"",
    "i18n:report": "vue-i18n-extract report --vueFiles \"src/**/*.?(js|vue)\" --languageFiles \"{src/i18n/locales,../just-core/packages/ui/src/i18n/locales}/en.json\" --exclude kit."
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/number": "^3.6.9",
    "@quasar/extras": "^2.1.0",
    "@vueuse/core": "^15.0.0",
    "culori": "^4.0.2",
    "dom-accessibility-api": "^0.7.1",
    "konva": "^10.9.0",
    "marked": "^18.1.0",
    "pinia": "^4.0.3",
    "quasar": "^2.35.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-konva": "^4.0.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/compat": "^2.1.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@quasar/app-vite": "^3.10.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n-extract": "^2.0.7"
  },
  "lint-staged": {
    "*.{js,vue}": "biome check --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "allowScripts": {
    "electron": true,
    "better-sqlite3": true,
    "koffi": true,
    "esbuild": true,
    "@parcel/watcher": true,
    "onnxruntime-node": false
  }
}
